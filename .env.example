# Bill Maker - environment variables
# Copy to .env and replace placeholder values. Never commit .env.

# --- App ---
ENVIRONMENT=development
# Public URL of the frontend (used in emails and public bill links)
APP_BASE_URL=http://localhost:5173
# Comma-separated allowed origins (5173 = Vite dev, 3000 = docker nginx)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Postgres (used by docker-compose db service) ---
POSTGRES_USER=bill_maker
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=bill_maker

# --- Database ---
# Local (non-docker) connection string. docker-compose overrides this to point at the db service.
# Windows with Smart App Control on: psycopg2's DLL is blocked, so use the pure-Python driver
# instead: postgresql+pg8000://... (pip install -r backend/requirements-dev.txt installs it).
DATABASE_URL=postgresql://bill_maker:change-me-local-db-password@localhost:5432/bill_maker
# Separate database for pytest
TEST_DATABASE_URL=postgresql://bill_maker:change-me-local-db-password@localhost:5432/bill_maker_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Resend (transactional email) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=billing@yourdomain.com

# --- Dodo Payments ---
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# --- Storage ---
# local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=5

# --- Scheduler ---
# Enable on exactly ONE backend instance to avoid double-billing
SCHEDULER_ENABLED=true
# Hour (UTC, 0-23) the daily billing job runs
SCHEDULER_CRON_HOUR=6

# --- Docker entrypoint ---
# Run "alembic upgrade head" on container start (compose sets this to true)
RUN_MIGRATIONS=false

# --- Frontend (build-time for docker image, runtime for Vite dev) ---
VITE_API_URL=http://localhost:8000
